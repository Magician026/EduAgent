# Required for real model calls.
OPENAI_API_KEY=

# Optional for OpenAI-compatible providers. Leave empty for the default OpenAI endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional local runtime overrides.
EDUAGENT_DATA_DIR=data
EDUAGENT_RETRIEVAL_TOP_K=5

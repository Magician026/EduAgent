# Chat / tutoring provider. DeepSeek, Kimi, OpenAI, and other
# OpenAI-compatible chat providers can be configured here.
EDUAGENT_LLM_API_KEY=
EDUAGENT_LLM_BASE_URL=
EDUAGENT_LLM_MODEL=gpt-4o-mini

# Embedding provider used for PDF indexing and query retrieval.
# It may be different from the chat provider.
EDUAGENT_EMBEDDING_API_KEY=
EDUAGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
EDUAGENT_EMBEDDING_MODEL=text-embedding-3-small

# Legacy single-provider aliases remain supported:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_BASE_URL=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional local runtime overrides.
EDUAGENT_DATA_DIR=data
EDUAGENT_RETRIEVAL_TOP_K=5
